@startuml diagramme_classes
!pragma layout smetana
title I. Diagramme de classes - Réservation de vols
skinparam classAttributeIconSize 0
hide empty members
hide circle

class "Compagnie aérienne" as Compagnie {
  nom
  --
  ouvrir réservation
  fermer réservation
}
class Vol {
  numéro
  date de départ
  date d'arrivée
  --
  ouvrir
  fermer
}
class Escale {
  heure d'arrivée
  heure de départ
}
class "Aéroport" as Aeroport {
  nom
}
class Ville {
  nom
}
class "Agence de voyage" as Agence {
  nom
}
class Client {
  nom
  adresse
}
class Passager {
  nom
}
class "Réservation" as Reservation {
  numéro
  date
  état
  --
  confirmer
  annuler
}

Compagnie "1" -- "1..*" Vol : propose
Compagnie "1" -- "*" Reservation : gère
Vol "*" -- "1" Aeroport : départ
Vol "*" -- "1" Aeroport : arrivée
Vol "1" -- "*" Escale : comporte
Escale "*" -- "1" Aeroport
Aeroport "*" -- "1..*" Ville : dessert
Agence "1" -- "*" Reservation : enregistre
Agence "1" -- "*" Client
Client "1" -- "*" Reservation : effectue
Reservation "*" -- "1" Vol : concerne
Reservation "*" -- "1" Passager : pour
@enduml
