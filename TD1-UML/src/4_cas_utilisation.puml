@startuml cas_utilisation
!pragma layout smetana
title IV. Cas d'utilisation - Réservation de vols
left to right direction

actor Client
actor "Agence" as Agence
actor "Compagnie" as Compagnie

rectangle "Système de réservation" {
  usecase "Réserver un vol" as UC1
  usecase "Confirmer une réservation" as UC2
  usecase "Annuler une réservation" as UC3
  usecase "Consulter les vols" as UC4
  usecase "Ouvrir / fermer un vol" as UC5
  usecase "Informer le passager" as UC6
}

Client -- UC1
Client -- UC2
Client -- UC3
Client -- UC4
Agence -- UC1
Agence -- UC2
Agence -- UC3
Compagnie -- UC5
Compagnie -- UC6
@enduml
